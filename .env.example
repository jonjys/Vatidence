# ---------------------------------------------------------------------------
# Required. The deployment will not serve a single request without these.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED connection string (the host contains "-pooler").
# Neon dashboard -> your project -> Connection string -> Pooled connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Stripe secret key. Dashboard -> Developers -> API keys.
# Start with sk_test_... and switch to sk_live_... when you are ready to take money.
STRIPE_SECRET_KEY="sk_test_..."

# Stripe webhook signing secret for the endpoint https://YOUR-DOMAIN/api/stripe/webhook
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET="whsec_..."

# The public origin of this deployment. No trailing slash. Used for Stripe
# redirects and for the permanent order links shown to customers.
APP_URL="https://vatproof.example.com"

# Random secret protecting /api/cron/reconcile. Minimum 16 characters.
# On Vercel, setting this also makes the platform authenticate its own cron calls.
#   generate with: openssl rand -hex 24
CRON_SECRET="change-me-to-32-random-characters"

# ---------------------------------------------------------------------------
# Required by law on the public pages (terms / refunds / privacy).
# ---------------------------------------------------------------------------

LEGAL_ENTITY="Your Company Ltd, Street 1, 111 22 City, Country"
SUPPORT_EMAIL="support@yourdomain.com"

# ---------------------------------------------------------------------------
# Optional. Every one of these has a production-safe default; leave them unset
# unless you have a reason.
# ---------------------------------------------------------------------------

# The single external API this product depends on. Free, no key, no account.
# VIES_BASE_URL="https://ec.europa.eu/taxation_customs/vies/rest-api"

# Parallel VIES calls. Raise carefully: the European Commission throttles and
# will start returning MS_MAX_CONCURRENT_REQ (which costs you retries, not money).
# VIES_MAX_CONCURRENCY="4"
# VIES_TIMEOUT_MS="15000"

# Rows per order, retry ceiling before a row is refunded, per-invocation budget.
# MAX_ITEMS_PER_ORDER="5000"
# MAX_ITEM_ATTEMPTS="8"
# RUN_BUDGET_MS="45000"

# GDPR retention: results stop being retrievable and identifying data is erased.
# DATA_RETENTION_DAYS="90"

# Abuse limits per IP address.
# RATE_LIMIT_PER_HOUR="20"
# RATE_LIMIT_PER_MINUTE="5"

# Set to "true" only after enabling Stripe Tax in your Stripe dashboard.
# STRIPE_TAX_ENABLED="false"

# LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Tests only. Never set in production.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL="postgres://postgres@127.0.0.1:5432/vatproof_test"
